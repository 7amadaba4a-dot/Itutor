5fb52'] = data;\n\n  // Give the browser tab a friendly title instead of the generic page name\n  try {\n    const otherName = data.role === 'teacher' ? data.student_name : data.teacher_name;\n    wwLib.getFrontDocument().title = 'Lesson with ' + (otherName || '...');\n  } catch (e) { /* noop */ }\n\n  // Bring back whatever was drawn in an earlier session of this same lesson.\n  try {\n    const wbRes = await fetch('https://kotzxqkagptcokpaviol.supabase.co/rest/v1/rpc/get_lesson_whiteboard', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'apikey': anonKey, 'Authorization': 'Bearer ' + anonKey },\n      body: JSON.stringify({ p_token: token, p_lesson_id: parseInt(lessonId, 10) })\n    });\n    if (wbRes.ok) {\n      const wb = await wbRes.json();\n      if (wb && wb.has_state && wb.state) {\n        variables['ae3b4c05-c069-4588-8f1f-91fb8d7e54a2'] = JSON.stringify(wb.state);\n      }\n    }\n  } catch (e) { /* an empty whiteboard is fine */ }\n} catch (e) {\n  console.log('Failed to load meeting access', e);\n  variables['b55dd664-6658-4b31-b636-78c566d2ccb6'] = 'Something went wrong loading this lesson.';\n}","name":"Read lesson id, fetch access, title and saved whiteboard","next":null,"type":"custom-js","__wwdescription":"Reads the lesson id from the URL (?lesson_id= or ?lessonId=) or from the joinLessonId variable set by the Join Lesson buttons, calls get_lesson_meeting_access, fills Meeting Access / Meeting Access Error, sets the tab title, and loads any whiteboard saved from an earlier session"}},"trigger":"onload","description":"On page load: resolve the lesson, authorize the user, set the tab title, and restore any previously saved whiteboard","firstAction":"read_and_fetch"},{"id":"6b808f9a-b67c-46b9-a311-e57ac3ab7f46","name":"Confirm Leave Classroom","folder":null,"actions":{"confirm":{"id":"confirm","code":"// Disabled: the meeting room component now has its own custom in-app leave-confirmation modal (shown when the Leave bu