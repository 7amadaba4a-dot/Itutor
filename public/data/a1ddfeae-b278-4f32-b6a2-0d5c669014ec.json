{"cacheVersion":"93","page":{"id":"a1ddfeae-b278-4f32-b6a2-0d5c669014ec","paths":{"default":"data-deletion"},"cmsDataSetPath":null,"workflows":[]},"sections":{"d8c09b53-7dcd-4bb6-98a9-2f49de4a19c0":{"uid":"d8c09b53-7dcd-4bb6-98a9-2f49de4a19c0","linkId":"726453f3-34e9-486a-a46d-355ad72ed7ef","_state":{"style":{"default":{"display":"flex","padding":"48px 24px","backgroundColor":"#FFFFFF"}}},"content":{"default":{"wwObjects":[{"uid":"3dd9f8a5-bf4c-497b-8dbb-9949378fcc21","isWwObject":true}],"_ww-layout_justifyContent":"center"}},"sectionBaseId":"99586bd3-2b15-4d6b-a025-6a50d07ca845","sectionTitle":"Data Deletion Root"}},"wwObjects":{"3dd9f8a5-bf4c-497b-8dbb-9949378fcc21":{"uid":"3dd9f8a5-bf4c-497b-8dbb-9949378fcc21","_state":{"style":{"default":{"width":"100%","display":"flex","maxWidth":"760px"}}},"content":{"default":{"children":[{"uid":"d772958c-cf39-4ca6-b9f1-4f9286d2081a","isWwObject":true}],"_ww-layout_flexDirection":"column"}},"name":"Article Container","wwObjectBaseId":"b783dc65-d528-4f74-8c14-e27c934c39b1","libraryComponentBaseId":null,"parentSectionId":"d8c09b53-7dcd-4bb6-98a9-2f49de4a19c0"},"d772958c-cf39-4ca6-b9f1-4f9286d2081a":{"uid":"d772958c-cf39-4ca6-b9f1-4f9286d2081a","_state":{},"content":{"default":{"tag":"div","_ww-text_text":{"en":"<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1E293B;line-height:1.7;font-size:16px;\"><h1 style=\"font-size:32px;font-weight:700;color:#0F172A;margin-bottom:4px;\">Data Deletion Instructions</h1><p style=\"color:#64748B;font-size:14px;margin-top:0;\">Last updated: July 27, 2026</p><p>You can request the deletion of your Languato account and all associated personal data at any time.</p><h2 style=\"font-size:22px;font-weight:700;color:#0F172A;margin-top:32px;\">How to Request Deletion</h2><p>Send an email to <a href=\"mailto:7amada.ba4a@gmail.com\" style=\"color:#0D9488;\">7amada.ba4a@gmail.com</a> from the email address associated with your Languato account, with the subject line \"Delete my account\". Please include your full name and the email address used to register.</p><h2 style=\"font-size:22px;font-weight:700;color:#0F172A;margin-top:32px;\">What Happens Next</h2><p>We will verify your request and permanently delete your account information — including your profile, lesson history, messages, and reviews — within 30 days. Some information may be retained where required by law, for example financial records related to completed payments.</p><h2 style=\"font-size:22px;font-weight:700;color:#0F172A;margin-top:32px;\">If You Signed Up With Google or Facebook</h2><p>Deleting your Languato account does not affect your Google or Facebook account itself. To remove Languato's access to your Google or Facebook account directly, visit your Google Account permissions page, or Facebook Settings &amp; Privacy → Settings → Apps and Websites, and remove \"Languato\" from the list.</p><h2 style=\"font-size:22px;font-weight:700;color:#0F172A;margin-top:32px;\">Contact</h2><p>Questions about data deletion? Email <a href=\"mailto:7amada.ba4a@gmail.com\" style=\"color:#0D9488;\">7amada.ba4a@gmail.com</a>.</p><p style=\"margin-top:24px;\">See also our <a href=\"/privacy-policy\" style=\"color:#0D9488;\">Privacy Policy</a>.</p></div>"}}},"name":"Deletion Body","wwObjectBaseId":"d7904e9d-fc9a-4d80-9e32-728e097879ad","libraryComponentBaseId":null,"parentSectionId":"d8c09b53-7dcd-4bb6-98a9-2f49de4a19c0"}},"collections":[],"variables":[{"id":"a351cdd7-fe01-4f4d-b209-438c5395f53a","type":"number","name":"id copier","defaultValue":0,"isLocalStorage":false,"isPersistentOnNav":true},{"id":"6cbc243c-51ab-4b98-b4da-f30eb14c622c","type":"object","name":"teacherProfile","defaultValue":{},"isLocalStorage":false,"isPersistentOnNav":false},{"id":"dec41a41-0426-4984-baf7-5c0f90748406","type":"array","name":"teacherReviews","defaultValue":[],"isLocalStorage":false,"isPersistentOnNav":false},{"id":"e1526f43-ac04-4b69-873b-7cf58f2ec0ee","type":"boolean","name":"isProfileFavorited","defaultValue":false,"isLocalStorage":false,"isPersistentOnNav":false}],"workflows":[],"formulas":[],"libraryComponents":[]}